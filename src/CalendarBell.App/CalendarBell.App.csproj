<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CalendarBell.App</RootNamespace>
    <AssemblyName>CalendarBell</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>CalendarBell.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\calendarbell.ico</ApplicationIcon>
    <Description>CalendarBell</Description>
    <AssemblyTitle>CalendarBell</AssemblyTitle>

    <!-- Unpackaged, self-contained Windows App SDK + .NET runtime -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- WPF Fluent ThemeMode is marked experimental in .NET 10 -->
    <!-- WFO0003: DPI awareness is declared in app.manifest on purpose (WPF owns the UI; WinForms is only used for NotifyIcon). -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CalendarBell.Core\CalendarBell.Core.csproj" />
    <ProjectReference Include="..\CalendarBell.Infrastructure\CalendarBell.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Icons\*.ico" />
    <Content Include="Resources\Icons\calendarbell.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Icons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
