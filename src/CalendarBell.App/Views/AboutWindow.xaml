<Window x:Class="CalendarBell.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CalendarBell.App.Localization"
        Title="{l:Loc About_Title}"
        Width="680" Height="560" MinWidth="520" MinHeight="400"
        FontFamily="{StaticResource AppFont}" FontSize="14" UseLayoutRounding="True"
        Icon="pack://application:,,,/Resources/Icons/calendarbell.ico">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnCloseCommand" />
  </Window.CommandBindings>
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="pack://application:,,,/Resources/Icons/calendarbell.ico" Width="40" Height="40" Margin="0,0,14,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc App_Name}" />
        <TextBlock Style="{StaticResource Secondary}" Text="{Binding VersionText}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,12,0,14" Text="{l:Loc About_Description}" />
    <DockPanel Grid.Row="2">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{l:Loc About_Diagnostics}" />
      <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Loc About_Diagnostics}" />
    </DockPanel>
    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Left" Padding="12,6" Content="{l:Loc Tray_CheckNow}" Command="{Binding CheckNowCommand}" />
      <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="12,6" Content="{l:Loc Settings_SendTest}" Command="{Binding SendTestCommand}" />
      <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="12,6" Content="{l:Loc About_OpenLogs}" Command="{Binding OpenLogsCommand}" />
      <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="12,6" Content="{l:Loc About_CopyDiagnostics}" Command="{Binding CopyCommand}" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="18,6" Content="{l:Loc Common_Close}" IsCancel="True" Click="OnCloseClick" />
      <TextBlock Style="{StaticResource Secondary}" Margin="12,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 Text="{Binding Info}" ToolTip="{Binding Info}" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
