<Window x:Class="CalendarBell.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CalendarBell.App.Localization"
        xmlns:vm="clr-namespace:CalendarBell.App.ViewModels"
        Title="{l:Loc Settings_Title}"
        Width="760" Height="560" MinWidth="560" MinHeight="420"
        FontFamily="{StaticResource AppFont}" FontSize="14" UseLayoutRounding="True"
        Icon="pack://application:,,,/Resources/Icons/calendarbell.ico"
        AutomationProperties.Name="{l:Loc Settings_Title}">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnCloseCommand" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,8" Focusable="False">
      <StackPanel>
        <!-- Banners -->
        <Border Style="{StaticResource CriticalBanner}" Visibility="{Binding ShowStorageError, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,3" Content="{l:Loc Banner_ResetStorage}" Command="{Binding ResetStorageCommand}" />
            <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Banner_StorageError}" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource CriticalBanner}" Visibility="{Binding ShowElevated, Converter={StaticResource VisibleWhen}}">
          <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Banner_Elevated}" />
        </Border>
        <Border Style="{StaticResource CautionBanner}" Visibility="{Binding ShowNotificationsOff, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,3" Content="{l:Loc Banner_OpenNotificationSettings}" Command="{Binding OpenNotificationSettingsCommand}" />
            <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Banner_NotificationsOff}" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource InfoBanner}" Visibility="{Binding ShowQuiet, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,3" Content="{l:Loc Banner_OpenNotificationSettings}" Command="{Binding OpenNotificationSettingsCommand}" />
            <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Banner_Quiet}" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource CautionBanner}" Visibility="{Binding ShowDeliveryFailed, Converter={StaticResource VisibleWhen}}">
          <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Banner_DeliveryFailed}" />
        </Border>
        <Border Style="{StaticResource InfoBanner}" Visibility="{Binding ShowPaused, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,3" Content="{l:Loc Banner_Resume}" Command="{Binding ResumeCommand}" />
            <TextBlock Style="{StaticResource BannerText}" Text="{Binding PausedText}" />
          </DockPanel>
        </Border>

        <!-- Calendars -->
        <DockPanel Margin="0,4,0,10" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc Settings_Calendars}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="12,6,0,0" Text="{Binding CalendarCountText}" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Padding="14,6" Command="{Binding AddCalendarCommand}"
                  Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="{l:Loc Settings_AddCalendar}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontWeight="SemiBold" Margin="0,0,6,0" />
              <TextBlock Text="{l:Loc Settings_AddCalendar}" />
            </StackPanel>
          </Button>
        </DockPanel>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasNoCalendars, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8">
          <TextBlock Style="{StaticResource Secondary}" FontSize="13.5" Text="{l:Loc Settings_NoCalendars}" />
        </Border>

        <ItemsControl ItemsSource="{Binding Calendars}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarRowViewModel}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0"
                            IsChecked="{Binding Enabled}" ToolTip="{l:Loc Settings_EnabledToggle}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Enabled: {0}'}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" ToolTip="{Binding Detail}">
                      <Ellipse Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{Binding Tone, Converter={StaticResource ToneToBrush}}" />
                      <TextBlock Style="{StaticResource Secondary}" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="6,0,0,0" Padding="12,4" Content="{l:Loc Settings_Edit}"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                    <Button Margin="6,0,0,0" Padding="12,4" Content="{l:Loc Settings_CheckNow}"
                            Command="{Binding DataContext.CheckNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Check {0} now'}" />
                    <Button Margin="6,0,0,0" Padding="12,4" Content="{l:Loc Settings_Remove}"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- General -->
        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{l:Loc Settings_General}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox Margin="0,2" IsChecked="{Binding StartWithWindows}" Content="{l:Loc Settings_StartWithWindows}" />
            <CheckBox Margin="0,2" IsChecked="{Binding PlaySound}" Content="{l:Loc Settings_PlaySound}" />
            <CheckBox Margin="0,2" IsChecked="{Binding PrivacyMode}" Content="{l:Loc Settings_PrivacyMode}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="28,0,0,8" Text="{l:Loc Settings_PrivacyHint}" />
            <Separator Margin="0,4,0,8" />
            <TextBlock Style="{StaticResource Secondary}" Text="{l:Loc Settings_InitialReminder}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="{l:Loc Settings_SnoozeTargets}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="24,12">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Padding="14,6" Content="{l:Loc Settings_SendTest}" Command="{Binding SendTestCommand}" />
        <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="14,6" Content="{l:Loc Settings_OpenUpcoming}" Command="{Binding OpenUpcomingCommand}" />
        <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="14,6" Content="{l:Loc Settings_Diagnostics}" Command="{Binding OpenAboutCommand}" />
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="18,6" Content="{l:Loc Common_Close}" IsCancel="True" Click="OnCloseClick" />
        <TextBlock Style="{StaticResource Secondary}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   Text="{Binding Info}" ToolTip="{Binding Info}" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
