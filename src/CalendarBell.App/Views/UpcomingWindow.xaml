<Window x:Class="CalendarBell.App.Views.UpcomingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CalendarBell.App.Localization"
        xmlns:vm="clr-namespace:CalendarBell.App.ViewModels"
        Title="{l:Loc Upcoming_Title}"
        Width="640" Height="600" MinWidth="480" MinHeight="360"
        FontFamily="{StaticResource AppFont}" FontSize="14" UseLayoutRounding="True"
        Icon="pack://application:,,,/Resources/Icons/calendarbell.ico">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="OnCloseCommand" />
  </Window.CommandBindings>
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc Upcoming_Title}" Margin="0,0,0,12" />

    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <ComboBox MinWidth="180" Margin="0,0,8,6" ItemsSource="{Binding CalendarFilters}" SelectedItem="{Binding CalendarFilter}" DisplayMemberPath="Label"
                AutomationProperties.Name="{l:Loc Upcoming_AllCalendars}" />
      <ComboBox MinWidth="160" Margin="0,0,12,6" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label"
                AutomationProperties.Name="{l:Loc Upcoming_AllStatuses}" />
      <CheckBox VerticalAlignment="Center" Margin="0,0,0,6" IsChecked="{Binding ShowDismissed}" Content="{l:Loc Upcoming_ShowDismissed}" />
    </WrapPanel>

    <Border Grid.Row="2" Style="{StaticResource InfoBanner}" Visibility="{Binding IsFilteredToNotification, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,3" Content="{l:Loc Upcoming_ShowAll}" Command="{Binding ShowAllCommand}" />
        <TextBlock Style="{StaticResource BannerText}" Text="{l:Loc Upcoming_FromNotification}" />
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
          <TextBlock Style="{StaticResource Secondary}" FontSize="13.5" Text="{l:Loc Upcoming_Empty}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:UpcomingGroupViewModel}">
              <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Header}" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UpcomingItemViewModel}">
                      <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel x:Name="Info">
                            <TextBlock Text="{Binding TimeRange}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Margin="0,2,0,0">
                              <Run Text="{Binding CalendarName, Mode=OneWay}" FontWeight="SemiBold" />
                              <Run Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <Run Text="{Binding Availability, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasTitle, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" Text="{Binding StatusText}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <ItemsControl ItemsSource="{Binding SnoozeOptions}" Focusable="False" HorizontalAlignment="Right">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel HorizontalAlignment="Right" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SnoozeOption}">
                                  <Button Margin="6,0,0,6" Padding="10,4" Content="{Binding Label}"
                                          Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                          AutomationProperties.Name="{Binding Label, StringFormat='Snooze to {0}'}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Right" Margin="6,0,0,0" Padding="12,4" Content="{l:Loc Action_Dismiss}"
                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource VisibleWhen}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Highlighted}" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                          <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInactive}" Value="True">
                          <Setter TargetName="Info" Property="Opacity" Value="0.6" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Padding="18,6" Content="{l:Loc Common_Close}" IsCancel="True" Click="OnCloseClick" />
      <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
