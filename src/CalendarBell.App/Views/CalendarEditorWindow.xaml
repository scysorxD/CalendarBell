<Window x:Class="CalendarBell.App.Views.CalendarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CalendarBell.App.Localization"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="14" UseLayoutRounding="True"
        Icon="pack://application:,,,/Resources/Icons/calendarbell.ico"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <StackPanel Margin="24,20,24,20">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" Margin="0,0,0,16" />

    <TextBlock Text="{l:Loc Editor_Name}" Margin="0,0,0,4" />
    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
             AutomationProperties.Name="{l:Loc Editor_Name}" />
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding NameError}" Visibility="{Binding NameError, Converter={StaticResource VisibleWhen}}" />

    <TextBlock Text="{l:Loc Editor_Url}" Margin="0,14,0,4" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <PasswordBox x:Name="UrlPassword" Grid.Column="0" MaxLength="4096" PasswordChanged="OnPasswordChanged"
                   AutomationProperties.Name="{l:Loc Editor_Url}"
                   Visibility="{Binding IsUrlVisible, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
      <TextBox x:Name="UrlText" Grid.Column="0" MaxLength="4096" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{l:Loc Editor_Url}"
               Visibility="{Binding IsUrlVisible, Converter={StaticResource VisibleWhen}}" />
      <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,4" Content="{Binding UrlVisibilityLabel}" Command="{Binding ToggleUrlVisibilityCommand}"
              AutomationProperties.Name="{Binding UrlVisibilityLabel}" />
    </Grid>
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding UrlError}" Visibility="{Binding UrlError, Converter={StaticResource VisibleWhen}}" />
    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{l:Loc Editor_UrlHint}" />

    <CheckBox Margin="0,14,0,0" IsChecked="{Binding Enabled}" Content="{l:Loc Editor_Enabled}" />

    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12,10"
            Visibility="{Binding TestMessage, Converter={StaticResource VisibleWhen}}">
      <StackPanel Orientation="Horizontal">
        <ProgressBar Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                     Visibility="{Binding IsTesting, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" MaxWidth="460" VerticalAlignment="Center"
                   Foreground="{Binding TestSucceeded, Converter={StaticResource TestResultBrush}}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SaveError}" Visibility="{Binding SaveError, Converter={StaticResource VisibleWhen}}" />

    <DockPanel Margin="0,22,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Padding="14,6" Content="{Binding TestButtonLabel}" Command="{Binding TestCommand}" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="22,6" Content="{l:Loc Editor_Save}" Command="{Binding SaveCommand}"
              IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
      <Button DockPanel.Dock="Right" Padding="16,6" Content="{l:Loc Common_Cancel}" IsCancel="True" />
    </DockPanel>
  </StackPanel>
</Window>
